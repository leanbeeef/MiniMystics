{
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "schema:sync": "node scripts/sync-schema.mjs",
    "prisma:generate": "npm run schema:sync && prisma generate --schema prisma/schema.prisma",
    "db:deploy": "npm run prisma:generate && dotenv -c '.env' -- prisma migrate deploy --schema prisma/schema.prisma",
    "build": "npm run prisma:generate && tsc",
    "lint": "eslint \"src\"",
    "start": "dotenv -c '.env' -- node dist/app",
    "dev": "npm run build && dotenv -c '.env' -- node --watch dist/app",
    "admin:create": "npm run build && dotenv -c '.env' -- node dist/scripts/create-admin",
    "setup": "npm run db:deploy && npm run admin:create"
  },
  "dependencies": {
    "@adminjs/design-system": "^4.1.1",
    "@adminjs/express": "^6.1.1",
    "@adminjs/prisma": "^5.0.4",
    "@prisma/client": "^6.15.0",
    "adminjs": "^7.8.17",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.2.1",
    "express-formidable": "^1.2.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^5.58.0",
    "@typescript-eslint/parser": "^5.58.0",
    "dotenv-cli": "^7.2.1",
    "eslint": "^8.38.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.1.0",
    "prisma": "^6.15.0",
    "tslib": "^2.5.0",
    "typescript": "^5.9.2"
  },
  "name": "admin",
  "description": "Private Mini Mystics administration service",
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}

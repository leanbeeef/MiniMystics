{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minimystics",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "minimystics"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "mini-mystics-opennext-cache"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a124d1bc630e4268a7cdf7f321025178"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    {
      "pattern": "*.minimystics.com/*",
      "zone_name": "minimystics.com"
    },
    {
      "pattern": "minimystics.com",
      "custom_domain": true
    }
  ],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  }
}

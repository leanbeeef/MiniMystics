{
  "name": "mini-mystics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run assets:optimize",
    "dev": "next dev --turbopack",
    "prebuild": "npm run assets:optimize",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "admin:cloudflare:check": "wrangler deploy --config wrangler.admin.jsonc --dry-run --containers-rollout=none",
    "admin:cloudflare:deploy": "wrangler deploy --config wrangler.admin.jsonc",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:optimize": "node scripts/optimize-images.mjs",
    "data:import": "tsx scripts/import-cards.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@pixi/particle-emitter": "^5.0.10",
    "@prisma/client": "6.15.0",
    "bcryptjs": "3.0.2",
    "firebase": "^12.18.0",
    "jose": "6.0.12",
    "lucide-react": "0.542.0",
    "next": "15.5.24",
    "papaparse": "5.5.3",
    "pixi.js": "^7.4.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-pageflip": "^2.0.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "24.3.0",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "prisma": "6.15.0",
    "sharp": "^0.35.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "^3.2.7",
    "wrangler": "4.129.0"
  }
}

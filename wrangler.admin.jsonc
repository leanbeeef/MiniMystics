{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minimystics-admin",
  "main": "admin/cloudflare-worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "admin.minimystics.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "HOST": "0.0.0.0",
    "PORT": "3001",
    "NODE_ENV": "production",
    "TRUST_PROXY": "true",
    "PUBLIC_GAME_URL": "https://minimystics.com"
  },
  "secrets": {
    "required": ["DATABASE_URL", "COOKIE_SECRET"]
  },
  "containers": [
    {
      "name": "minimystics-admin",
      "class_name": "MiniMysticsAdminContainer",
      "image": "./admin.Dockerfile",
      "image_build_context": ".",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMIN_CONTAINER",
        "class_name": "MiniMysticsAdminContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "admin-v1",
      "new_sqlite_classes": ["MiniMysticsAdminContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
